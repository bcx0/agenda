generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  passwordHash    String
  creditsPerMonth Int
  isActive        Boolean   @default(true)
  bookings        Booking[]
  recurringBlocks RecurringBlock[]
  createdAt       DateTime  @default(now())
}

model Booking {
  id                    Int       @id @default(autoincrement())
  clientId              Int
  client                Client    @relation(fields: [clientId], references: [id])
  startAt               DateTime
  endAt                 DateTime
  timeZone              String    @default("Europe/Brussels")
  status                String    @default("CONFIRMED")
  mode                  String    @default("VISIO")
  cancelReason          String?
  rescheduleReason      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt          // ✅ UNE SEULE FOIS
  manageToken           String?   @unique            // ✅ UNE SEULE FOIS
  manageTokenExpiresAt  DateTime?                    // ✅ UNE SEULE FOIS
  googleEventId         String?   @unique
  googleEtag            String?
  syncStatus            String    @default("pending")
  syncSource            String    @default("app")
  lastSyncedAt          DateTime?
  bookedBy              String    @default("client") @map("booked_by")
  // Lien vers la série (RDV régulier) et la date d'origine de l'occurrence
  // dans le fuseau de la série. Permet de libérer automatiquement l'ancien
  // créneau quand la réservation est déplacée ou annulée (cf.
  // lib/availability-engine.mjs). NULL pour une réservation ponctuelle.
  recurringBlockId      Int?
  recurringBlock        RecurringBlock? @relation(fields: [recurringBlockId], references: [id], onDelete: SetNull)
  occurrenceDate        DateTime? @db.Date


  @@index([clientId])
  @@index([status])
  @@index([startAt])
  @@index([clientId, status])
  @@index([status, startAt])
  @@index([recurringBlockId, occurrenceDate])
}

model Block {
  id        Int      @id @default(autoincrement())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  googleEventId String?  @unique
  googleEtag    String?
  syncStatus    String   @default("pending")
  syncSource    String   @default("app")
  lastSyncedAt  DateTime?


  @@index([startAt])
}

enum AvailabilityOverrideType {
  BLOCK
  OPEN
}

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int
  startTime String
  endTime   String
  location  String   @default("MIAMI") // "MIAMI" | "BELGIUM"
  createdAt DateTime @default(now())
}

model LocationPeriod {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())
}

model AvailabilityOverride {
  id        Int                      @id @default(autoincrement())
  date      DateTime
  startTime String
  endTime   String
  type      AvailabilityOverrideType
  note      String?
  createdAt DateTime                 @default(now())
}

model RecurringBlock {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int
  startTime String
  endTime   String
  timeZone  String?
  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])
  note      String?
  createdAt DateTime @default(now())
  // Période de validité (dates dans le fuseau de la série, bornes incluses).
  // NULL = sans limite. Sert à « modifier cette occurrence et les suivantes »
  // (la série d'origine s'arrête la veille) et à borner une série.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  exceptions RecurringBlockException[]
  bookings   Booking[]
}

/// Exception sur UNE occurrence d'une série (RecurringBlock) :
///  - SKIP : l'occurrence est libérée ce jour-là ;
///  - MOVE : l'occurrence est déplacée (newStartAt/newEndAt bloqués à la place).
/// Une seule exception par occurrence (contrainte unique) : les écritures sont
/// idempotentes (upsert).
model RecurringBlockException {
  id               Int            @id @default(autoincrement())
  recurringBlockId Int
  recurringBlock   RecurringBlock @relation(fields: [recurringBlockId], references: [id], onDelete: Cascade)
  occurrenceDate   DateTime       @db.Date
  type             String // "SKIP" | "MOVE"
  newStartAt       DateTime?
  newEndAt         DateTime?
  bookingId        Int?
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@unique([recurringBlockId, occurrenceDate])
  @@index([newStartAt])
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Settings {
  id                 Int         @id @default(1)
  location           String      @default("MIAMI") // MIAMI | BELGIUM
  presentielLocation String      @default("Vander Valk")
  presentielNote     String?
  defaultMode        String      @default("VISIO") // VISIO | PRESENTIEL
  bookingLocked      Boolean     @default(false)
  updatedAt          DateTime    @updatedAt
}

model SessionMode {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  mode      String
  location  String?
  createdAt DateTime @default(now())

  @@map("session_modes")
}

model GoogleToken {
  id                 Int       @id @default(autoincrement())
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  googleEmail        String?
  syncToken          String?
  // Failover : refresh token de la connexion PRÉCÉDENTE, gardé en secours.
  // Quand Google tue la famille de tokens active (post_refresh_401 +
  // mintedNewToken=false, pannes quotidiennes de juillet 2026), l'app bascule
  // automatiquement dessus au lieu d'attendre une reconnexion humaine.
  backupRefreshToken String?
  backupUpdatedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model GoogleCalendarWatch {
  id         Int      @id @default(autoincrement())
  channelId  String   @unique
  resourceId String
  expiration DateTime
  createdAt  DateTime @default(now())
  renewedAt  DateTime @default(now())
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  table     String
  recordId  Int?
  action    String
  direction String
  details   Json?
  createdAt DateTime @default(now())

  @@index([table, action, createdAt])
}

/// Prospect: personne qui souhaite rencontrer Geoffrey mais SANS compte client
/// ni contrat. Volontairement découplé de Client (pas d'email unique, pas de
/// mot de passe) pour ne rien casser au flux client confirmé + crédits, et pour
/// que l'email du coach puisse servir à plusieurs prospects. L'identité affichée
/// vient de `name`, jamais de l'email.
model Prospect {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  desiredAt DateTime?
  note      String?
  status    String    @default("NEW") // NEW | CONTACTED | CONVERTED | ARCHIVED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}
